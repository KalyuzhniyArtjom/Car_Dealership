@page
@model Car_Dealership.Pages.Account.LogoutModel
@{
    ViewData["Title"] = "Выход";
}
<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-5 col-md-7">
            <div class="card-dark text-center p-5">
                <div style="width: 72px; height: 72px; border-radius: 50%; background: rgba(212, 168, 83, 0.1); display: inline-flex; align-items: center; justify-content: center; margin-bottom: 1.5rem;">
                    <i class="fas fa-sign-out-alt" style="color: var(--accent); font-size: 2rem;"></i>
                </div>
                <h2 class="h4 fw-bold mb-2" style="color: var(--text-primary);">Выход выполнен</h2>
                <p class="text-muted small mb-4">Вы успешно вышли из системы</p>
                <a asp-page="/Index" class="btn-gold">
                    <i class="fas fa-home me-2"></i>На главную
                </a>
            </div>
        </div>
    </div>
</div>