@page
@model Car_Dealership.Pages.Account.User.CreateModel
@{
    ViewData["Title"] = "Новый пользователь";
}
<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-6 col-md-8">
            <div class="card-dark">
                <div class="card-body p-4">
                    <div class="d-flex align-items-center gap-3 mb-4">
                        <div style="width: 4px; height: 32px; background: var(--accent); border-radius: 4px;"></div>
                        <h2 class="h4 mb-0" style="font-weight: 700;">Новый пользователь</h2>
                    </div>

                    <form method="post">
                        <div class="mb-3">
                            <label asp-for="User.Email" class="form-label" style="font-weight: 500; font-size: 0.85rem; color: var(--text-secondary);">Email адрес</label>
                            <input asp-for="User.Email" class="form-control" style="background: var(--bg-primary); border-color: var(--border-color); color: var(--text-primary);" placeholder="user@example.com" />
                            <span asp-validation-for="User.Email" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="User.Password" class="form-label" style="font-weight: 500; font-size: 0.85rem; color: var(--text-secondary);">Пароль</label>
                            <input asp-for="User.Password" type="password" class="form-control" style="background: var(--bg-primary); border-color: var(--border-color); color: var(--text-primary);" placeholder="••••••••" />
                            <span asp-validation-for="User.Password" class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="User.Role" class="form-label" style="font-weight: 500; font-size: 0.85rem; color: var(--text-secondary);">Роль доступа</label>
                            <select asp-for="User.Role" class="form-select" style="background: var(--bg-primary); border-color: var(--border-color); color: var(--text-primary);">
                                <option value="User">User</option>
                                <option value="Admin">Admin</option>
                            </select>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn-gold">
                                <i class="fas fa-save me-2"></i>Создать
                            </button>
                            <a asp-page="Index" class="btn-ghost">
                                <i class="fas fa-arrow-left me-2"></i>Назад
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}