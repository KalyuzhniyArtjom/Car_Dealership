@page
@model Car_Dealership.Pages.Account.User.IndexModel
@{
    ViewData["Title"] = "Пользователи";
}
<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <div class="d-flex align-items-center gap-3">
                <div style="width: 4px; height: 32px; background: var(--accent); border-radius: 4px;"></div>
                <h1 class="h4 mb-0" style="font-weight: 700;">Пользователи</h1>
            </div>
            <span class="text-muted small">Всего: @Model.Users.Count()</span>
        </div>
        <a asp-page="./Create" class="btn-gold">
            <i class="fas fa-plus me-2"></i>Новый пользователь
        </a>
    </div>

    @if (Model.Users.Any())
    {
        <div class="row g-3">
            @foreach (var user in Model.Users)
            {
                <div class="col-lg-4 col-md-6">
                    <div class="card-dark" style="height: 100%;">
                        <div class="card-body p-4">
                            <div class="d-flex align-items-start justify-content-between mb-3">
                                <div class="d-flex align-items-center gap-3">
                                    <div class="user-avatar" style="width: 44px; height: 44px; font-size: 1rem; flex-shrink: 0;">@user.Email?.Substring(0, 1).ToUpper()</div>
                                    <div>
                                        <div class="fw-bold text-truncate" style="max-width: 140px;" title="@user.Email">@user.Email</div>
                                        <span class="badge" style="background: @(user.Role == "Admin" ? "var(--accent)" : "var(--text-muted)"); color: @(user.Role == "Admin" ? "#0a0a0a" : "#fff"); font-size: 0.65rem; padding: 3px 10px;">@user.Role</span>
                                    </div>
                                </div>
                                <small class="text-muted" style="font-size: 0.65rem;">ID: @user.Id</small>
                            </div>
                            <div class="d-flex gap-2 mt-2">
                                <a asp-page="./Details" asp-route-id="@user.Id" class="btn-ghost" style="flex: 1; text-align: center; padding: 6px 12px; font-size: 0.75rem;">
                                    <i class="fas fa-eye me-1"></i>Детали
                                </a>
                                <a asp-page="./Edit" asp-route-id="@user.Id" class="btn-gold" style="flex: 1; text-align: center; padding: 6px 12px; font-size: 0.75rem;">
                                    <i class="fas fa-edit me-1"></i>Изменить
                                </a>
                                <a asp-page="./Delete" asp-route-id="@user.Id" class="btn" style="flex: 1; text-align: center; padding: 6px 12px; font-size: 0.75rem; background: transparent; border: 1px solid #dc3545; color: #dc3545; border-radius: var(--radius-sm); transition: var(--transition);">
                                    <i class="fas fa-trash me-1"></i>Удалить
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="card-dark p-5 text-center">
            <i class="fas fa-users" style="font-size: 3rem; color: var(--text-muted); opacity: 0.3; margin-bottom: 1rem;"></i>
            <h5 class="text-muted">Список пользователей пуст</h5>
            <p class="text-muted small">Нажмите «Новый пользователь», чтобы добавить первого</p>
        </div>
    }
</div>