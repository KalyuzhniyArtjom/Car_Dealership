@page
@model Car_Dealership.Pages.Account.User.IndexModel
@{
    ViewData["Title"] = "Пользователи";
}
<div class="container mt-4">
    <div class="row justify-content-between align-items-center mb-4">
        <div class="col">
            <h1 class="h3 mb-0">Список пользователей</h1>
        </div>
        <div class="col-auto">
            <a asp-page="./Create" class="btn btn-primary rounded-pill px-4">
                + Добавить пользователя
            </a>
        </div>
    </div>
    <div class="row">
        @foreach (var user in Model.Users)
        {
            <div class="col-md-6 col-lg-4 mb-4">
                <div class="card shadow-sm h-100 rounded-4">
                    <div class="card-body">
                        <div class="d-flex align-items-center mb-3">
                            <div class="text-truncate w-100">
                                <h5 class="card-title text-primary text-truncate mb-1" title="@user.Email">
                                    @user.Email
                                </h5>
                                <span class="badge @(user.Role == "Admin" ? "bg-danger" : "bg-secondary")">
                                    @user.Role
                                </span>
                            </div>
                        </div>
                    </div>
                    <div class="card-footer d-flex justify-content-between rounded-bottom-4 bg-body-secondary">
                        <small class="text-muted align-self-center">ID: @user.Id</small>
                        <div class="btn-group gap-2">
                            <a asp-page="./Delete" asp-route-id="@user.Id" class="btn btn-sm btn-outline-danger rounded-pill px-3">Удалить</a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
    @if (!Model.Users.Any())
    {
        <div class="alert alert-info text-center rounded-4">
            Список пользователей пуст.
        </div>
    }
</div>