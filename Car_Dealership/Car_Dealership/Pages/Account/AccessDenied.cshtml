@page
@model Car_Dealership.Pages.Account.AccessDeniedModel
@{
    ViewData["Title"] = "Доступ запрещен";
}
<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6 text-center">
            <div class="card shadow border-0 rounded-4 p-5">
                <div class="text-danger mb-4">
                    <i class="bi bi-exclamation-triangle-fill" style="font-size: 3rem;"></i>
                    <h1 class="display-1 fw-bold">403</h1>
                </div>
                <h2 class="h4 fw-bold text-dark mb-3">Доступ ограничен</h2>
                <p class="text-muted mb-4">
                    У вашего аккаунта недостаточно прав для просмотра этой страницы.
                    Пожалуйста, обратитесь к администратору или вернитесь на главную.
                </p>
                <div class="d-grid gap-2 d-sm-flex justify-content-sm-center">
                    <a asp-page="/Index" class="btn btn-dark rounded-pill px-4">На главную</a>
                    <a asp-page="./Login" class="btn btn-outline-secondary rounded-pill px-4">Войти в другой аккаунт</a>
                </div>
            </div>
        </div>
    </div>
</div>