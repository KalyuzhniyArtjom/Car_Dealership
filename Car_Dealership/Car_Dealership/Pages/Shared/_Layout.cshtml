﻿<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Авто-Профи</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/AutoRepairShop.styles.css" asp-append-version="true" />

    <style>
        :root {
            --bg-body: #f4f7f6;
            --bg-navbar: #ffffff;
            --text-main: #212529;
            --border-color: rgba(0,0,0,0.05);
        }

        [data-theme="dark"] {
            --bg-body: #121212;
            --bg-navbar: #1e1e1e;
            --text-main: #f8f9fa;
            --border-color: rgba(255,255,255,0.1);
        }

            /* Адаптация элементов формы под темную тему */
            [data-theme="dark"] .form-label {
                color: #f8f9fa !important;
            }

            [data-theme="dark"] .form-control,
            [data-theme="dark"] .form-select {
                background-color: #2b2b2b !important;
                color: #f8f9fa !important;
                border-color: #444444 !important;
            }

                [data-theme="dark"] .form-control::placeholder {
                    color: #a0a0a0 !important;
                    opacity: 1;
                }

            [data-theme="dark"] .card {
                background-color: #1e1e1e !important;
                border-color: rgba(255,255,255,0.1) !important;
            }

        html, body {
            height: 100%;
        }

        body {
            display: flex;
            flex-direction: column;
            background-color: var(--bg-body) !important;
            color: var(--text-main);
            transition: background-color 0.3s ease;
        }

        main {
            flex: 1 0 auto;
        }

        .navbar {
            background-color: var(--bg-navbar) !important;
            box-shadow: 0 2px 10px var(--border-color);
            border: none !important;
        }

        .navbar-brand {
            font-weight: 700;
            letter-spacing: -0.5px;
        }

        .nav-link {
            font-weight: 500;
            color: var(--text-main) !important;
        }

        .footer {
            flex-shrink: 0;
            background: var(--bg-navbar);
            color: var(--text-main);
            padding: 20px 0;
            border-top: 1px solid var(--border-color) !important;
        }

        [data-theme="dark"] .text-muted,
        [data-theme="dark"] .text-secondary {
            color: #adb5bd !important;
        }

        [data-theme="dark"] .text-dark {
            color: #f8f9fa !important;
        }
    </style>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm mb-4">
            <div class="container">
                <a class="navbar-brand text-primary" asp-page="/Index">🛠️ Авто-Профи</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item"><a class="nav-link" asp-page="/Index">Главная</a></li>
                        <li class="nav-item"><a class="nav-link" asp-page="/Cars/Index">Автомобили</a></li>
                        <li class="nav-item"><a class="nav-link" asp-page="/Clients/Index">Клиенты</a></li>

                        @* Вкладка открыта для проверки. Как только убедимся, что работает — закроем её под админа *@
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item">
                                <a class="nav-link text-danger fw-bold" asp-page="/Account/User/Index">Пользователи</a>
                            </li>
                        }
                    </ul>

                    <ul class="navbar-nav ms-auto d-flex align-items-center gap-3">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item d-flex align-items-center">
                                <a asp-page="/Account/Profile" class="text-decoration-none fw-bold me-2" style="color: var(--text-main);">
                                    👤 @User.Identity.Name
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="btn btn-sm btn-outline-danger rounded-pill px-3" asp-page="/Account/Logout">Выход</a>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="btn btn-sm btn-outline-primary rounded-pill px-3" asp-page="/Account/Login">Вход</a>
                            </li>
                            <li class="nav-item">
                                <a class="btn btn-sm btn-primary rounded-pill px-3" asp-page="/Account/Register">Регистрация</a>
                            </li>
                        }

                        <li class="nav-item ms-2">
                            <div class="form-check form-switch m-0">
                                <input class="form-check-input" type="checkbox" id="themeToggle" style="cursor:pointer;">
                                <label class="form-check-label ms-1" for="themeToggle" id="themeIcon">☀️</label>
                            </div>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-5">
            @RenderBody()
        </main>
    </div>

    <footer class="footer shadow-sm">
        <div class="container text-center">
            <div class="row">
                <div class="col-md-6 text-md-start">
                    &copy; @DateTime.Now.Year — <strong>Авто-Профи</strong>
                </div>
                <div class="col-md-6 text-md-end">
                    <a asp-page="/Privacy" class="text-muted text-decoration-none mx-2">Конфиденциальность</a>
                </div>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        const toggle = document.getElementById('themeToggle');
        const icon = document.getElementById('themeIcon');
        const html = document.documentElement;

        const setTheme = (theme) => {
            html.setAttribute('data-theme', theme);
            localStorage.setItem('theme', theme);
            if (toggle) toggle.checked = theme === 'dark';
            if (icon) icon.textContent = theme === 'dark' ? '🌙' : '☀️';
        };

        const current = localStorage.getItem('theme') || (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        setTheme(current);

        if (toggle) {
            toggle.addEventListener('change', () => setTheme(toggle.checked ? 'dark' : 'light'));
        }
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>