@page
@model IndexModel
@{
    ViewData["Title"] = "Home page";
}
<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <style>
        /* Светлая тема (по умолчанию) */
        body {
            background: linear-gradient(135deg, #e0c3fc 0%, #8ec5fc 100%);
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            transition: all 0.3s ease;
        }

            /* Темная тема */
            body.dark-mode {
                background: linear-gradient(135deg, #1a1a2e 0%, #16213e 100%);
            }

                body.dark-mode .navbar-custom {
                    background: rgba(30, 30, 46, 0.95);
                    box-shadow: 0 2px 20px rgba(0,0,0,0.3);
                }

                    body.dark-mode .navbar-custom .navbar-brand,
                    body.dark-mode .nav-link-custom {
                        color: #e0e0e0;
                    }

                body.dark-mode .hero-card {
                    background: rgba(30, 30, 46, 0.92);
                }

                    body.dark-mode .hero-card h1,
                    body.dark-mode .hero-card .lead {
                        color: #e0e0e0 !important;
                    }

                body.dark-mode .footer {
                    background: rgba(30, 30, 46, 0.9);
                }

                    body.dark-mode .footer small,
                    body.dark-mode .footer a {
                        color: #a0a0a0 !important;
                    }

                body.dark-mode .btn-outline-gradient {
                    background: #2d2d44;
                    color: #e0e0e0;
                    border-color: #667eea;
                }

                body.dark-mode .stats-card {
                    background: #2d2d44;
                    color: #e0e0e0;
                }

        .navbar-custom {
            background: rgba(255, 255, 255, 0.95);
            backdrop-filter: blur(10px);
            box-shadow: 0 2px 20px rgba(0,0,0,0.1);
            border-radius: 0 0 20px 20px;
            transition: all 0.3s ease;
        }

        .nav-link-custom {
            color: #4a5568;
            font-weight: 500;
            padding: 10px 20px;
            border-radius: 30px;
            transition: all 0.3s ease;
        }

            .nav-link-custom:hover {
                background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
                color: white;
                transform: translateY(-2px);
            }

        .hero-card {
            background: rgba(255, 255, 255, 0.92);
            border-radius: 30px;
            transition: transform 0.3s ease;
        }

            .hero-card:hover {
                transform: translateY(-5px);
            }

        .welcome-icon {
            font-size: 4rem;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            -webkit-background-clip: text;
            background-clip: text;
            color: transparent;
        }

        .btn-gradient {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            border: none;
            padding: 12px 30px;
            border-radius: 50px;
            transition: all 0.2s;
        }

            .btn-gradient:hover {
                transform: translateY(-2px);
                box-shadow: 0 10px 20px rgba(102,126,234,0.3);
                color: white;
            }

        .btn-outline-gradient {
            border: 2px solid #667eea;
            color: #667eea;
            border-radius: 50px;
            padding: 12px 30px;
            transition: all 0.2s;
            background: white;
        }

            .btn-outline-gradient:hover {
                background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
                color: white;
                border-color: transparent;
            }

        .footer {
            background: rgba(255, 255, 255, 0.9);
            border-radius: 20px 20px 0 0;
            margin-top: auto;
            transition: all 0.3s ease;
        }

        .theme-toggle {
            cursor: pointer;
            font-size: 1.5rem;
            transition: transform 0.3s ease;
        }

            .theme-toggle:hover {
                transform: rotate(15deg);
            }

        body.dark-mode .theme-toggle {
            color: #ffd700;
        }

        .stats-card {
            background: white;
            border-radius: 20px;
            padding: 20px;
            text-align: center;
            transition: all 0.3s ease;
        }

            .stats-card:hover {
                transform: translateY(-5px);
                box-shadow: 0 10px 25px rgba(0,0,0,0.1);
            }

        .stats-number {
            font-size: 2rem;
            font-weight: bold;
            color: #667eea;
        }

        body.dark-mode .stats-number {
            color: #8ec5fc;
        }
    </style>
</head>
<body>
    <!-- Навигация сверху -->
    <nav class="navbar navbar-custom px-4 py-2 mb-5">
        <div class="container">
            <a class="navbar-brand fw-bold text-dark" href="/">
                <i class="bi bi-car-front-fill me-2 text-primary"></i>
                AutoDeal
            </a>
            <div class="ms-auto d-flex align-items-center gap-3">
                <a asp-page="/Cars/Index" class="btn nav-link-custom me-2 text-decoration-none">
                    <i class="bi bi-car-front me-1"></i>
                    Автомобили
                </a>
                <a asp-page="/Clients/Index" class="btn nav-link-custom text-decoration-none">
                    <i class="bi bi-people me-1"></i>
                    Клиенты
                </a>
                <!-- Кнопка переключения темы -->
                <i class="bi bi-moon-stars-fill theme-toggle" id="themeToggle"></i>
            </div>
        </div>
    </nav>

    <!-- Основной контент -->
    <div class="container my-auto py-5">
        <div class="row justify-content-center">
            <div class="col-md-8">
                <div class="hero-card p-5 text-center shadow-lg">
                    <i class="bi bi-car-front-fill welcome-icon mb-4 d-block"></i>

                    <h1 class="display-4 fw-bold text-dark mb-3">
                        Добро пожаловать в проект автосалон
                    </h1>

                    <p class="lead text-secondary mb-4">
                        <i class="bi bi-geo-alt-fill me-1"></i>
                        Ваш надежный автомобильный партнер
                    </p>

                    <div class="mt-4">
                        <a href="https://learn.microsoft.com/aspnet/core" target="_blank" class="btn btn-gradient me-2">
                            <i class="bi bi-book me-2"></i>
                            Документация
                        </a>
                        <a asp-page="/Cars/Index" class="btn btn-outline-gradient">
                            <i class="bi bi-car-front me-2"></i>
                            Перейти к автомобилям
                        </a>
                    </div>

                    <div class="mt-5 pt-3">
                        <small class="text-muted">
                            <i class="bi bi-star-fill text-warning"></i>
                            <i class="bi bi-star-fill text-warning"></i>
                            <i class="bi bi-star-fill text-warning"></i>
                            <i class="bi bi-star-fill text-warning"></i>
                            <i class="bi bi-star-fill text-warning"></i>
                            <span class="ms-2">Лучший выбор для вас</span>
                        </small>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Футер -->
    <footer class="footer text-center py-3 mt-5">
        <div class="container">
            <small class="text-muted">
                © 2026 - Car_Dealership -
                <a href="#" class="text-decoration-none text-secondary">Privacy</a>
            </small>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // Переключение темной темы
        const themeToggle = document.getElementById('themeToggle');

        // Проверяем сохраненную тему в localStorage
        if (localStorage.getItem('darkMode') === 'enabled') {
            document.body.classList.add('dark-mode');
            themeToggle.classList.remove('bi-moon-stars-fill');
            themeToggle.classList.add('bi-sun-fill');
        }

        themeToggle.addEventListener('click', () => { 
            document.body.classList.toggle('dark-mode');

            if (document.body.classList.contains('dark-mode')) {
                localStorage.setItem('darkMode', 'enabled');
                themeToggle.classList.remove('bi-moon-stars-fill');
                themeToggle.classList.add('bi-sun-fill');
            } else {
                localStorage.setItem('darkMode', 'disabled');
                themeToggle.classList.remove('bi-sun-fill');
                themeToggle.classList.add('bi-moon-stars-fill'); 
            }
        });
    </script>
</body>
</html>
