@page
@model Car_Dealership.Pages.Cars.IndexModel
@{
}
<h1>Список авто</h1>

<p>
    <a asp-page="Create">Добавить новый автомобиль</a>
</p>

<table border="1" cellpadding="5">
    <thead>
        <tr>
            <th>Название</th>
            <th>Страна производитель</th>
            <th>Цена</th>
            <th>Год выпуска</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var car in Model.Cars)
        {
            <tr>
                <td>@car.Title</td>
                <td>@car.Сountry</td>
                <td>@car.Price</td>
                <td>@car.YearOfManufacture</td>
                <td>
                    <a asp-page="Details" asp-route-id="@car.Id">Открыть</a>
                    <a asp-page="Edit" asp-route-id="@car.Id">Изменить</a>
                    <a asp-page="Delete" asp-route-id="@car.Id">Удалить</a>
                </td>
            </tr>
        }
    </tbody>
</table>