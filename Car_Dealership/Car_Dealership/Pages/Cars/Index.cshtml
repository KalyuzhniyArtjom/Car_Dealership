@page
@model Car_Dealership.Pages.Cars.IndexModel
@{
    ViewData["Title"] = "Автопарк";
}
<div class="container py-4">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-4 gap-3">
        <div>
            <div class="d-flex align-items-center gap-3">
                <div style="width: 4px; height: 32px; background: var(--accent); border-radius: 4px;"></div>
                <h1 class="h4 mb-0" style="font-weight: 700;">
                    <i class="fas fa-car-side me-2" style="color: var(--accent);"></i>Автомобили
                </h1>
            </div>
            <span class="text-muted small">Всего: @Model.Cars.Count()</span>
        </div>
        <a asp-page="Create" class="btn-gold">
            <i class="fas fa-plus me-2"></i>Добавить
        </a>
    </div>

    @* Статистика *@
    @{
        var cars = Model.Cars.ToList();
        var avgPrice = cars.Any() ? cars.Average(c => c.Price) : 0;
        var newCars = cars.Count(c => c.YearOfManufacture >= DateTime.Now.Year - 3);
    }

    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card-dark p-3 text-center">
                <div style="font-size: 0.75rem; text-transform: uppercase; letter-spacing: 1px; color: var(--text-muted);">Всего авто</div>
                <div style="font-size: 2rem; font-weight: 700; color: var(--accent);">@cars.Count</div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card-dark p-3 text-center">
                <div style="font-size: 0.75rem; text-transform: uppercase; letter-spacing: 1px; color: var(--text-muted);">Средняя цена</div>
                <div style="font-size: 2rem; font-weight: 700; color: var(--accent);">@avgPrice.ToString("N0") ₽</div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card-dark p-3 text-center">
                <div style="font-size: 0.75rem; text-transform: uppercase; letter-spacing: 1px; color: var(--text-muted);">Новинки</div>
                <div style="font-size: 2rem; font-weight: 700; color: var(--accent);">@newCars</div>
            </div>
        </div>
    </div>

    @if (cars.Any())
    {
        <div class="row g-3">
            @foreach (var car in cars)
            {
                <div class="col-lg-4 col-md-6">
                    <div class="card-dark" style="height: 100%;">
                        <div class="card-body p-4">
                            <div style="display: flex; align-items: center; gap: 1rem; margin-bottom: 1rem;">
                                <div style="width: 48px; height: 48px; border-radius: 50%; background: rgba(212, 168, 83, 0.1); display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
                                    <i class="fas fa-car" style="color: var(--accent); font-size: 1.3rem;"></i>
                                </div>
                                <div class="text-truncate">
                                    <div class="fw-bold text-truncate" style="font-size: 1.05rem;">@car.Title</div>
                                    <span class="text-muted" style="font-size: 0.8rem;">@car.Country</span>
                                </div>
                            </div>

                            <div style="display: flex; justify-content: space-between; padding: 6px 0; border-bottom: 1px solid var(--border-color);">
                                <span style="color: var(--text-secondary); font-size: 0.8rem;">Год выпуска</span>
                                <span style="font-weight: 500; font-size: 0.85rem;">@car.YearOfManufacture</span>
                            </div>
                            <div style="display: flex; justify-content: space-between; padding: 6px 0;">
                                <span style="color: var(--text-secondary); font-size: 0.8rem;">Цена</span>
                                <span style="font-weight: 700; color: var(--accent);">@car.Price.ToString("N0") ₽</span>
                            </div>
                        </div>
                        <div class="card-footer" style="background: transparent; border-top: 1px solid var(--border-color); padding: 12px 20px;">
                            <div class="d-flex gap-2">
                                <a asp-page="Details" asp-route-id="@car.Id" class="btn-ghost" style="flex: 1; text-align: center; padding: 6px 12px; font-size: 0.75rem;">
                                    <i class="fas fa-eye me-1"></i>Детали
                                </a>
                                <a asp-page="Edit" asp-route-id="@car.Id" class="btn-gold" style="flex: 1; text-align: center; padding: 6px 12px; font-size: 0.75rem;">
                                    <i class="fas fa-edit me-1"></i>Изменить
                                </a>
                                <a asp-page="Delete" asp-route-id="@car.Id" class="btn" style="flex: 1; text-align: center; padding: 6px 12px; font-size: 0.75rem; background: transparent; border: 1px solid #dc3545; color: #dc3545; border-radius: var(--radius-sm); transition: var(--transition);">
                                    <i class="fas fa-trash me-1"></i>Удалить
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="card-dark p-5 text-center">
            <i class="fas fa-car-side" style="font-size: 3rem; color: var(--text-muted); opacity: 0.3; margin-bottom: 1rem;"></i>
            <h5 class="text-muted">Нет автомобилей</h5>
            <p class="text-muted small">Нажмите «Добавить», чтобы создать первый автомобиль</p>
        </div>
    }
</div>