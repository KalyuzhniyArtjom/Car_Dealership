@page
@model Car_Dealership.Pages.Cars.EditModel
@{
}
<h1>Редактировать автомобиль</h1>

<form method="post">
    <input type="hidden" asp-for="Car.Id" />

    <div>
        <label>Название</label><br />
        <input asp-for="Car.Title" />
    </div>

    <div>
        <label>Автор</label><br />
        <input asp-for="Car.Сountry" />
    </div>

    <div>
        <label>Год</label><br />
        <input asp-for="Car.Year" type="number" />
    </div>

    <div>
        <label>Количество</label><br />
        <input asp-for="Car.Quantity" type="number" />
    </div>

    <button type="submit">Сохранить</button>
</form>

<a asp-page="Index">Назад</a>