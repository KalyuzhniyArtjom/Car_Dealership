@page
@model Car_Dealership.Pages.Cars.EditModel
@{
    ViewData["Title"] = "Редактировать автомобиль";
}
<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-6 col-md-8">
            <div class="card-dark">
                <div class="card-body p-4">
                    <div class="d-flex align-items-center gap-3 mb-4">
                        <div style="width: 4px; height: 32px; background: var(--accent); border-radius: 4px;"></div>
                        <h2 class="h4 mb-0" style="font-weight: 700;">
                            <i class="fas fa-edit me-2" style="color: var(--accent);"></i>Редактировать автомобиль
                        </h2>
                    </div>

                    <form method="post">
                        <input type="hidden" asp-for="Car.Id" />

                        <div class="mb-3">
                            <label asp-for="Car.Title" class="form-label" style="font-weight: 500; font-size: 0.85rem; color: var(--text-secondary);">
                                <i class="fas fa-car me-2" style="color: var(--accent);"></i>Название
                            </label>
                            <input asp-for="Car.Title" class="form-control" style="background: var(--bg-primary); border-color: var(--border-color); color: var(--text-primary); padding: 12px 16px;" />
                            <span asp-validation-for="Car.Title" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Car.BrandCarId" class="form-label" style="font-weight: 500; font-size: 0.85rem; color: var(--text-secondary);">
                                <i class="fas fa-tag me-2" style="color: var(--accent);"></i>Бренд
                            </label>
                            <select asp-for="Car.BrandCarId" class="form-select" style="background: var(--bg-primary); border-color: var(--border-color); color: var(--text-primary); padding: 12px 16px;">
                                @foreach (var brand in Model.Brands)
                                {
                                    <option value="@brand.Id" selected="@(brand.Id == Model.Car.BrandCarId)">@brand.Name</option>
                                }
                            </select>
                            <span asp-validation-for="Car.BrandCarId" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Car.Country" class="form-label" style="font-weight: 500; font-size: 0.85rem; color: var(--text-secondary);">
                                <i class="fas fa-globe me-2" style="color: var(--accent);"></i>Страна
                            </label>
                            <input asp-for="Car.Country" class="form-control" style="background: var(--bg-primary); border-color: var(--border-color); color: var(--text-primary); padding: 12px 16px;" />
                            <span asp-validation-for="Car.Country" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Car.YearOfManufacture" class="form-label" style="font-weight: 500; font-size: 0.85rem; color: var(--text-secondary);">
                                <i class="fas fa-calendar me-2" style="color: var(--accent);"></i>Год выпуска
                            </label>
                            <input asp-for="Car.YearOfManufacture" type="number" class="form-control" style="background: var(--bg-primary); border-color: var(--border-color); color: var(--text-primary); padding: 12px 16px;" />
                            <span asp-validation-for="Car.YearOfManufacture" class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Car.Price" class="form-label" style="font-weight: 500; font-size: 0.85rem; color: var(--text-secondary);">
                                <i class="fas fa-ruble-sign me-2" style="color: var(--accent);"></i>Цена
                            </label>
                            <input asp-for="Car.Price" type="number" step="0.01" class="form-control" style="background: var(--bg-primary); border-color: var(--border-color); color: var(--text-primary); padding: 12px 16px;" />
                            <span asp-validation-for="Car.Price" class="text-danger small"></span>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn-gold">
                                <i class="fas fa-save me-2"></i>Сохранить
                            </button>
                            <a asp-page="Index" class="btn-ghost">
                                <i class="fas fa-arrow-left me-2"></i>Назад
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}