@page
@model Car_Dealership.Pages.Cars.EditModel
@{
}
<h1>Редактировать автомобиль</h1>

<form method="post">
    <input type="hidden" asp-for="Car.Id" />

    <div>
        <label>Название</label><br />
        <input asp-for="Car.Title" />
    </div>

    <div>
        <label>Страна</label><br />
        <input asp-for="Car.Сountry" />
    </div>

    <div>
        <label>Год выпуска</label><br />
        <input asp-for="Car.YearOfManufacture" type="number" />
    </div>

    <div>
        <label>Цена</label><br />
        <input asp-for="Car.Price" type="number" />
    </div>

    <button type="submit">Сохранить</button>
</form>

<a asp-page="Index">Назад</a>