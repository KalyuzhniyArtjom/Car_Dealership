@page
@model Car_Dealership.Pages.Cars.DetailsModel
@{
}
<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">
    <div class="container py-5">
        <div class="row justify-content-center">
            <div class="col-md-6">
                <div class="card shadow-lg border-0">
                    <div class="card-header bg-success text-white text-center py-4">
                        <h1 class="h3 mb-0">ℹ️ Информация об автомобиле</h1>
                    </div>

                    <div class="card-body p-4">
                        <div class="bg-light p-4 rounded mb-4">
                            <div class="mb-3 pb-3 border-bottom">
                                <p class="text-secondary mb-1"><strong>Название:</strong></p>
                                <p class="h5 text-dark mb-0">@Model.Car.Title</p>
                            </div>

                            <div class="mb-3 pb-3 border-bottom">
                                <p class="text-secondary mb-1"><strong>Страна:</strong></p>
                                <p class="h5 text-dark mb-0">@Model.Car.Country</p>
                            </div>

                            <div class="mb-3 pb-3 border-bottom">
                                <p class="text-secondary mb-1"><strong>Год выпуска:</strong></p>
                                <p class="h5 text-dark mb-0">@Model.Car.YearOfManufacture</p>
                            </div>

                            <div class="mb-3">
                                <p class="text-secondary mb-1"><strong>Цена:</strong></p>
                                <p class="h5 text-success mb-0 fw-bold">@Model.Car.Price ₽</p>
                            </div>
                        </div>

                        <div class="text-center">
                            <a asp-page="Index" class="btn btn-success btn-lg px-4">
                                ◀️ Назад к списку
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>