@page
@model Car_Dealership.Pages.Clients.IndexModel
@{
    ViewData["Title"] = "Клиенты";
}
<div class="container py-4">
    @* Статистика *@
    @{
        var clients = Model.Client.ToList();
        var monthVisitors = clients.Count(c => c.VisitDate >= DateTime.Now.AddMonths(-1));
        var birthdayThisMonth = clients.Count(c => c.BirthDate.Month == DateTime.Now.Month);
    }

    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card-dark p-3 text-center">
                <div style="font-size: 0.75rem; text-transform: uppercase; letter-spacing: 1px; color: var(--text-muted);">Всего клиентов</div>
                <div style="font-size: 2rem; font-weight: 700; color: var(--accent);">@clients.Count</div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card-dark p-3 text-center">
                <div style="font-size: 0.75rem; text-transform: uppercase; letter-spacing: 1px; color: var(--text-muted);">За последний месяц</div>
                <div style="font-size: 2rem; font-weight: 700; color: var(--accent);">@monthVisitors</div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card-dark p-3 text-center">
                <div style="font-size: 0.75rem; text-transform: uppercase; letter-spacing: 1px; color: var(--text-muted);">Именинников в этом месяце</div>
                <div style="font-size: 2rem; font-weight: 700; color: var(--accent);">@birthdayThisMonth</div>
            </div>
        </div>
    </div>

    @* Заголовок *@
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-4 gap-3">
        <div>
            <div class="d-flex align-items-center gap-3">
                <div style="width: 4px; height: 32px; background: var(--accent); border-radius: 4px;"></div>
                <h1 class="h4 mb-0" style="font-weight: 700;">
                    <i class="fas fa-users me-2" style="color: var(--accent);"></i>Наши клиенты
                </h1>
            </div>
        </div>
        <a asp-page="Create" class="btn-gold">
            <i class="fas fa-plus me-2"></i>Добавить клиента
        </a>
    </div>

    @if (clients.Any())
    {
        <div class="row g-3">
            @foreach (var client in clients)
            {
                <div class="col-lg-4 col-md-6">
                    <div class="card-dark" style="height: 100%;">
                        <div class="card-body p-4">
                            <div class="d-flex align-items-center gap-3 mb-3">
                                <div class="user-avatar" style="width: 48px; height: 48px; font-size: 1rem; flex-shrink: 0;">@client.FullName?.Substring(0, 1).ToUpper()</div>
                                <div class="text-truncate">
                                    <div class="fw-bold text-truncate" style="font-size: 1rem;">@client.FullName</div>
                                    <span class="text-muted" style="font-size: 0.75rem;">ID: @client.Id</span>
                                </div>
                            </div>

                            <div style="display: flex; justify-content: space-between; padding: 6px 0; border-bottom: 1px solid var(--border-color);">
                                <span style="color: var(--text-secondary); font-size: 0.8rem;">
                                    <i class="fas fa-calendar-check me-1" style="color: var(--accent);"></i>Визит
                                </span>
                                <span style="font-weight: 500; font-size: 0.85rem;">@client.VisitDate.ToString("dd.MM.yyyy")</span>
                            </div>
                            <div style="display: flex; justify-content: space-between; padding: 6px 0; border-bottom: 1px solid var(--border-color);">
                                <span style="color: var(--text-secondary); font-size: 0.8rem;">
                                    <i class="fas fa-phone me-1" style="color: var(--accent);"></i>Телефон
                                </span>
                                <span style="font-weight: 500; font-size: 0.85rem;">@(string.IsNullOrEmpty(client.PhoneNumber) ? "—" : client.PhoneNumber)</span>
                            </div>
                            <div style="display: flex; justify-content: space-between; padding: 6px 0;">
                                <span style="color: var(--text-secondary); font-size: 0.8rem;">
                                    <i class="fas fa-cake me-1" style="color: var(--accent);"></i>День рождения
                                </span>
                                <span style="font-weight: 500; font-size: 0.85rem;">
                                    @client.BirthDate.ToString("dd.MM.yyyy")
                                    @if (client.BirthDate.Month == DateTime.Now.Month && client.BirthDate.Day == DateTime.Now.Day)
                                    {
                                        <span class="badge" style="background: #dc3545; color: #fff; font-size: 0.6rem; padding: 2px 8px;">🎂</span>
                                    }
                                </span>
                            </div>
                        </div>
                        <div class="card-footer" style="background: transparent; border-top: 1px solid var(--border-color); padding: 12px 20px;">
                            <div class="d-flex gap-2">
                                <a asp-page="Details" asp-route-id="@client.Id" class="btn-ghost" style="flex: 1; text-align: center; padding: 6px 12px; font-size: 0.75rem;">
                                    <i class="fas fa-eye me-1"></i>Детали
                                </a>
                                <a asp-page="Edit" asp-route-id="@client.Id" class="btn-gold" style="flex: 1; text-align: center; padding: 6px 12px; font-size: 0.75rem;">
                                    <i class="fas fa-edit me-1"></i>Изменить
                                </a>
                                <a asp-page="Delete" asp-route-id="@client.Id" class="btn" style="flex: 1; text-align: center; padding: 6px 12px; font-size: 0.75rem; background: transparent; border: 1px solid #dc3545; color: #dc3545; border-radius: var(--radius-sm); transition: var(--transition);">
                                    <i class="fas fa-trash me-1"></i>Удалить
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="card-dark p-5 text-center">
            <i class="fas fa-users" style="font-size: 3rem; color: var(--text-muted); opacity: 0.3; margin-bottom: 1rem;"></i>
            <h5 class="text-muted">Нет клиентов</h5>
            <p class="text-muted small">Нажмите «Добавить клиента», чтобы создать первую запись</p>
        </div>
    }
</div>