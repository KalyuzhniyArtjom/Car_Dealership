@page
@model Car_Dealership.Pages.Clients.CreateModel
@{
    ViewData["Title"] = "Новый клиент";
}
<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-6 col-md-8">
            <div class="card-dark">
                <div class="card-body p-4">
                    <div class="d-flex align-items-center gap-3 mb-4">
                        <div style="width: 4px; height: 32px; background: var(--accent); border-radius: 4px;"></div>
                        <h2 class="h4 mb-0" style="font-weight: 700;">
                            <i class="fas fa-user-plus me-2" style="color: var(--accent);"></i>Новый клиент
                        </h2>
                    </div>

                    <form method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                        <div class="mb-3">
                            <label asp-for="Client.FullName" class="form-label" style="font-weight: 500; font-size: 0.85rem; color: var(--text-secondary);">
                                <i class="fas fa-user me-2" style="color: var(--accent);"></i>ФИО клиента
                            </label>
                            <input asp-for="Client.FullName" class="form-control" style="background: var(--bg-primary); border-color: var(--border-color); color: var(--text-primary); padding: 12px 16px;" placeholder="Иванов Иван Иванович" />
                            <span asp-validation-for="Client.FullName" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Client.VisitDate" class="form-label" style="font-weight: 500; font-size: 0.85rem; color: var(--text-secondary);">
                                <i class="fas fa-calendar-check me-2" style="color: var(--accent);"></i>Дата визита
                            </label>
                            <input asp-for="Client.VisitDate" type="date" class="form-control" style="background: var(--bg-primary); border-color: var(--border-color); color: var(--text-primary); padding: 12px 16px;" />
                            <span asp-validation-for="Client.VisitDate" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Client.PhoneNumber" class="form-label" style="font-weight: 500; font-size: 0.85rem; color: var(--text-secondary);">
                                <i class="fas fa-phone me-2" style="color: var(--accent);"></i>Номер телефона
                            </label>
                            <input asp-for="Client.PhoneNumber" class="form-control" style="background: var(--bg-primary); border-color: var(--border-color); color: var(--text-primary); padding: 12px 16px;" placeholder="+7 (999) 123-45-67" />
                            <span asp-validation-for="Client.PhoneNumber" class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Client.BirthDate" class="form-label" style="font-weight: 500; font-size: 0.85rem; color: var(--text-secondary);">
                                <i class="fas fa-cake me-2" style="color: var(--accent);"></i>Дата рождения
                            </label>
                            <input asp-for="Client.BirthDate" type="date" class="form-control" style="background: var(--bg-primary); border-color: var(--border-color); color: var(--text-primary); padding: 12px 16px;" />
                            <span asp-validation-for="Client.BirthDate" class="text-danger small"></span>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn-gold">
                                <i class="fas fa-save me-2"></i>Сохранить
                            </button>
                            <a asp-page="Index" class="btn-ghost">
                                <i class="fas fa-arrow-left me-2"></i>Назад
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}