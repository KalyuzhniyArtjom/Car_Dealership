@page
@model Car_Dealership.Pages.Clients.DeleteModel
@{
    ViewData["Title"] = "Удалить клиента";
}
<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-6 col-md-8">
            <div class="card-dark text-center p-4">
                <div style="width: 72px; height: 72px; border-radius: 50%; background: rgba(220, 53, 69, 0.1); display: inline-flex; align-items: center; justify-content: center; margin-bottom: 1.5rem;">
                    <i class="fas fa-user" style="color: #dc3545; font-size: 2rem;"></i>
                </div>
                <h3 class="h5 fw-bold mb-2" style="color: var(--text-primary);">Удалить клиента?</h3>
                <p class="text-muted small mb-4">Это действие нельзя отменить. Все данные клиента будут удалены.</p>

                <div class="card-dark p-3 text-start mb-4" style="background: var(--bg-primary);">
                    <div style="display: flex; justify-content: space-between; padding: 8px 0; border-bottom: 1px solid var(--border-color);">
                        <span style="color: var(--text-secondary); font-size: 0.85rem;">ФИО</span>
                        <span style="font-weight: 500; font-size: 0.85rem;">@Model.Client.FullName</span>
                    </div>
                    <div style="display: flex; justify-content: space-between; padding: 8px 0; border-bottom: 1px solid var(--border-color);">
                        <span style="color: var(--text-secondary); font-size: 0.85rem;">Телефон</span>
                        <span style="font-weight: 500; font-size: 0.85rem;">@(string.IsNullOrEmpty(Model.Client.PhoneNumber) ? "—" : Model.Client.PhoneNumber)</span>
                    </div>
                    <div style="display: flex; justify-content: space-between; padding: 8px 0;">
                        <span style="color: var(--text-secondary); font-size: 0.85rem;">Дата рождения</span>
                        <span style="font-weight: 500; font-size: 0.85rem;">@Model.Client.BirthDate.ToString("dd.MM.yyyy")</span>
                    </div>
                </div>

                <form method="post">
                    <input type="hidden" asp-for="Client.Id" />
                    <div class="d-flex justify-content-center gap-2">
                        <button type="submit" class="btn" style="background: #dc3545; border: none; color: #fff; font-weight: 600; padding: 10px 32px; border-radius: var(--radius-sm); transition: var(--transition);">
                            <i class="fas fa-trash me-2"></i>Да, удалить
                        </button>
                        <a asp-page="Index" class="btn-ghost">
                            <i class="fas fa-times me-2"></i>Отмена
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>