@page
@model Car_Dealership.Pages.Clients.DetailsModel
@{
}
<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">

        <div class="card shadow-sm mt-4">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0">Информация о клиенте</h5>
            </div>

            <div class="card-body">

                <dl class="row mb-0">
                    <dt class="col-sm-4">ФИО</dt>
                    <dd class="col-sm-8">@Model.Client.FullName</dd>

                    <dt class="col-sm-4">Дата Визита</dt>
                    <dd class="col-sm-8">@Model.Client.VisitDate</dd>

                    <dt class="col-sm-4">Телефон</dt>
                    <dd class="col-sm-8">
                        @(string.IsNullOrEmpty(Model.Client.PhoneNumber)
                                                ? "—"
                                                : Model.Client.PhoneNumber)
                    </dd>

                    <dt class="col-sm-4">Дата рождения</dt>
                    <dd class="col-sm-8">
                        @Model.Client.BirthDate.ToShortDateString()
                    </dd>
                </dl>

            </div>

            <div class="card-footer d-flex justify-content-between">
                <a asp-page="Index" class="btn btn-outline-secondary">
                    Назад
                </a>

                <div>
                    <a asp-page="Edit"
                       asp-route-id="@Model.Client.Id"
                       class="btn btn-warning me-2">
                        Редактировать
                    </a>

                    <a asp-page="Delete"
                       asp-route-id="@Model.Client.Id"
                       class="btn btn-danger">
                        Удалить
                    </a>
                </div>
            </div>
        </div>

    </div>
</div>