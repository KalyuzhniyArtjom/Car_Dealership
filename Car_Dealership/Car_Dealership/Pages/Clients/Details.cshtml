@page
@model Car_Dealership.Pages.Clients.DetailsModel
@{
    ViewData["Title"] = "Детали клиента";
}
<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-6 col-md-8">
            <div class="card-dark">
                <div class="card-body p-4">
                    <div class="d-flex align-items-center gap-3 mb-4">
                        <div style="width: 4px; height: 32px; background: var(--accent); border-radius: 4px;"></div>
                        <h2 class="h4 mb-0" style="font-weight: 700;">
                            <i class="fas fa-user me-2" style="color: var(--accent);"></i>Детали клиента
                        </h2>
                    </div>

                    <div class="d-flex align-items-center gap-3 mb-4 p-3" style="background: var(--bg-primary); border-radius: var(--radius-sm); border: 1px solid var(--border-color);">
                        <div class="user-avatar" style="width: 56px; height: 56px; font-size: 1.3rem; flex-shrink: 0;">@Model.Client.FullName?.Substring(0, 1).ToUpper()</div>
                        <div>
                            <div class="fw-bold" style="font-size: 1.1rem;">@Model.Client.FullName</div>
                            <span class="text-muted small">ID: @Model.Client.Id</span>
                        </div>
                    </div>

                    <div class="mb-4">
                        <div style="display: flex; justify-content: space-between; padding: 10px 0; border-bottom: 1px solid var(--border-color);">
                            <span style="color: var(--text-secondary); font-size: 0.85rem;">
                                <i class="fas fa-calendar-check me-2" style="color: var(--accent);"></i>Дата визита
                            </span>
                            <span style="font-weight: 500; font-size: 0.85rem;">
                                @Model.Client.VisitDate.ToString("dd.MM.yyyy")
                                @if (Model.Client.VisitDate.Date == DateTime.Now.Date)
                                {
                                    <span class="badge" style="background: var(--accent); color: #0a0a0a; font-size: 0.6rem; padding: 2px 10px; margin-left: 8px;">Сегодня</span>
                                }
                            </span>
                        </div>
                        <div style="display: flex; justify-content: space-between; padding: 10px 0; border-bottom: 1px solid var(--border-color);">
                            <span style="color: var(--text-secondary); font-size: 0.85rem;">
                                <i class="fas fa-phone me-2" style="color: var(--accent);"></i>Телефон
                            </span>
                            <span style="font-weight: 500; font-size: 0.85rem;">@(string.IsNullOrEmpty(Model.Client.PhoneNumber) ? "—" : Model.Client.PhoneNumber)</span>
                        </div>
                        <div style="display: flex; justify-content: space-between; padding: 10px 0;">
                            <span style="color: var(--text-secondary); font-size: 0.85rem;">
                                <i class="fas fa-cake me-2" style="color: var(--accent);"></i>Дата рождения
                            </span>
                            <span style="font-weight: 500; font-size: 0.85rem;">
                                @Model.Client.BirthDate.ToString("dd.MM.yyyy")
                                @if (Model.Client.BirthDate.Month == DateTime.Now.Month && Model.Client.BirthDate.Day == DateTime.Now.Day)
                                {
                                    <span class="badge" style="background: #dc3545; color: #fff; font-size: 0.6rem; padding: 2px 10px; margin-left: 8px;">🎂 День рождения!</span>
                                }
                            </span>
                        </div>
                    </div>

                    <div class="d-flex gap-2 flex-wrap">
                        <a asp-page="Index" class="btn-ghost">
                            <i class="fas fa-arrow-left me-2"></i>Назад
                        </a>
                        <a asp-page="Edit" asp-route-id="@Model.Client.Id" class="btn-gold">
                            <i class="fas fa-edit me-2"></i>Редактировать
                        </a>
                        <a asp-page="Delete" asp-route-id="@Model.Client.Id" class="btn" style="background: transparent; border: 1px solid #dc3545; color: #dc3545; font-weight: 600; padding: 10px 24px; border-radius: var(--radius-sm); transition: var(--transition);">
                            <i class="fas fa-trash me-2"></i>Удалить
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>