@page
@model Car_Dealership.Pages.Clients.DetailsModel
@{
}
<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
</head>
<body class="bg-light">
    <div class="container py-5">
        <div class="row justify-content-center">
            <div class="col-md-6">
                <div class="card shadow-lg border-0">
                    <div class="card-header bg-success text-white text-center py-4">
                        <h1 class="h3 mb-0">ℹ️ Информация о клиенте</h1>
                    </div>

                    <div class="card-body p-4">
                        <div class="bg-light p-4 rounded mb-4">
                            <div class="mb-3 pb-3 border-bottom">
                                <p class="text-secondary mb-1">
                                    <i class="bi bi-person-fill me-2"></i>
                                    <strong>ФИО</strong>
                                </p>
                                <p class="h5 text-dark mb-0">@Model.Client.FullName</p>
                            </div>

                            <div class="mb-3 pb-3 border-bottom">
                                <p class="text-secondary mb-1">
                                    <i class="bi bi-calendar-check-fill me-2"></i>
                                    <strong>Дата визита</strong>
                                </p>
                                <p class="h5 text-dark mb-0">@Model.Client.VisitDate</p>
                            </div>

                            <div class="mb-3 pb-3 border-bottom">
                                <p class="text-secondary mb-1">
                                    <i class="bi bi-telephone-fill me-2"></i>
                                    <strong>Телефон</strong>
                                </p>
                                <p class="h5 text-dark mb-0">
                                    @(string.IsNullOrEmpty(Model.Client.PhoneNumber) ? "—" : Model.Client.PhoneNumber)
                                </p>
                            </div>

                            <div class="mb-3">
                                <p class="text-secondary mb-1">
                                    <i class="bi bi-cake2-fill me-2"></i>
                                    <strong>Дата рождения</strong>
                                </p>
                                <p class="h5 text-dark mb-0">@Model.Client.BirthDate.ToString()</p>
                            </div>
                        </div>

                        <div class="d-flex gap-2 justify-content-between">
                            <a asp-page="Index" class="btn btn-outline-secondary btn-lg">
                                <i class="bi bi-arrow-left me-2"></i>
                                Назад
                            </a>

                            <div class="d-flex gap-2">
                                <a asp-page="Edit" asp-route-id="@Model.Client.Id" class="btn btn-warning btn-lg">
                                    <i class="bi bi-pencil-fill me-2"></i>
                                    Редактировать
                                </a>

                                <a asp-page="Delete" asp-route-id="@Model.Client.Id" class="btn btn-danger btn-lg">
                                    <i class="bi bi-trash3-fill me-2"></i>
                                    Удалить
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>